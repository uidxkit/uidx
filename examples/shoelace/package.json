{
  "name": "@uidx/example-shoelace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A design system over Shoelace's web components: uidx identities supply the look through Shoelace's ::part()s, Shoelace supplies behaviour and accessibility.",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --maxWorkers=2 --testTimeout=20000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "2.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uidx/codegen": "workspace:*",
    "@uidx/format": "workspace:*",
    "@uidx/schema": "workspace:*",
    "@uidxkit/uidx": "workspace:*",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
