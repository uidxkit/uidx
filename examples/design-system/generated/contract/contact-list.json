{
  "id": "contact-list",
  "components": [
    {
      "name": "ContactList",
      "implements": "hwc-radio-group",
      "status": "stable",
      "boundParts": [],
      "treeSlots": [
        "option",
        "empty"
      ],
      "axes": {
        "state": [
          "default",
          "disabled",
          "empty"
        ]
      }
    }
  ],
  "contract": {
    "props": [
      {
        "name": "items",
        "type": "Contact[]",
        "controllable": false,
        "visual": false,
        "description": "The people to choose from, in order."
      },
      {
        "name": "name",
        "type": "string",
        "controllable": false,
        "visual": false,
        "description": "Form field name shared by every option."
      },
      {
        "name": "disabled",
        "type": "boolean",
        "controllable": false,
        "visual": true,
        "description": "Every option inert.",
        "default": false
      }
    ],
    "events": [],
    "states": [],
    "parts": [],
    "slots": [
      {
        "name": "option",
        "description": "One option per element of items .",
        "accepts": "hwc-radio"
      },
      {
        "name": "empty",
        "description": "Shown instead of the options while items is empty."
      }
    ],
    "composes": [
      "ContactOption",
      "Field"
    ],
    "accessibility": {
      "role": "radiogroup",
      "keyboard": "Arrow keys move the choice"
    }
  },
  "behavior": [
    {
      "id": "one-choice",
      "text": "exactly one option is chosen at a time; choosing one unchooses the rest."
    },
    {
      "id": "keyboard",
      "text": "arrow keys move the choice through the options; Tab leaves the group."
    },
    {
      "id": "empty",
      "text": "with no items the empty slot shows and nothing is chosen."
    }
  ],
  "examples": [
    {
      "name": "second-chosen",
      "sets": [
        {
          "slot": "option",
          "count": 3
        },
        {
          "at": "option[1]",
          "state": "checked"
        }
      ]
    }
  ],
  "styles": [
    {
      "keys": {
        "state": "empty"
      },
      "values": {
        "empty": {
          "visible": true
        }
      }
    },
    {
      "keys": {
        "state": "disabled"
      },
      "values": {
        "root": {
          "opacity": "{opacity#disabled}"
        }
      }
    }
  ]
}
