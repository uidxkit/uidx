{
  "id": "contact-list",
  "components": [
    {
      "name": "ContactList",
      "implements": "hwc-radio-group",
      "status": "stable",
      "boundParts": [],
      "treeSlots": [
        "empty"
      ],
      "axes": {
        "state": [
          "default",
          "disabled"
        ]
      }
    }
  ],
  "contract": {
    "props": [
      {
        "name": "items",
        "controllable": false,
        "visual": false,
        "description": "The people to choose from, in order.",
        "type": "Contact[]"
      },
      {
        "name": "name",
        "controllable": false,
        "visual": false,
        "description": "Form field name shared by every option.",
        "type": "string"
      },
      {
        "name": "disabled",
        "controllable": false,
        "visual": true,
        "description": "Every option inert.",
        "type": "boolean",
        "default": false
      }
    ],
    "events": [],
    "states": {
      "structural": [],
      "styling": [
        "disabled"
      ]
    },
    "parts": [],
    "slots": [
      {
        "name": "option",
        "repeats": true,
        "description": "One option per element of items .",
        "model": "{models#Contact}",
        "accepts": "hwc-radio"
      },
      {
        "name": "empty",
        "repeats": false,
        "description": "Shown instead of the options while items is empty."
      }
    ],
    "composes": [
      "ContactOption",
      "Field"
    ],
    "accessibility": {
      "role": "radiogroup",
      "keyboard": "Arrow keys move the choice"
    }
  },
  "models": [
    {
      "name": "Contact",
      "description": "One person as a row shows them. Every value is display-ready; the adapter that builds it does any formatting.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "key": true,
          "optional": false,
          "description": "Stable identity, used for keys and as the submitted value.",
          "sample": [
            "ada",
            "grace",
            "linus"
          ]
        },
        {
          "name": "name",
          "type": "string",
          "key": false,
          "optional": false,
          "description": "Full display name.",
          "sample": [
            "Ada Lovelace",
            "Grace Hopper",
            "Linus Torvalds"
          ]
        },
        {
          "name": "email",
          "type": "string",
          "key": false,
          "optional": true,
          "description": "Omitted when unknown; the row hides the line.",
          "sample": [
            "ada@example.com",
            null,
            "linus@example.com"
          ]
        }
      ]
    }
  ],
  "behavior": [
    {
      "id": "one-choice",
      "text": "exactly one option is chosen at a time; choosing one unchooses the rest."
    },
    {
      "id": "keyboard",
      "text": "arrow keys move the choice through the options; Tab leaves the group."
    },
    {
      "id": "empty",
      "text": "with no items the empty slot shows and nothing is chosen."
    }
  ],
  "examples": [
    {
      "name": "second-chosen",
      "sets": [
        {
          "slot": "option",
          "count": 3
        },
        {
          "at": "option[1]",
          "state": "checked"
        }
      ]
    }
  ],
  "styles": [
    {
      "keys": {
        "state": "disabled"
      },
      "values": {
        "root": {
          "opacity": "{opacity#disabled}"
        }
      }
    }
  ]
}
