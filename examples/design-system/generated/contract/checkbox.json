{
  "id": "checkbox",
  "components": [
    {
      "name": "Checkbox",
      "implements": "hwc-checkbox",
      "status": "stable",
      "boundParts": [
        "checked-indicator",
        "indeterminate-indicator"
      ],
      "treeSlots": [],
      "axes": {
        "state": [
          "default",
          "checked",
          "indeterminate",
          "hover",
          "focus",
          "disabled"
        ]
      }
    }
  ],
  "contract": {
    "props": [
      {
        "name": "checked",
        "controllable": true,
        "visual": true,
        "description": "Whether the option is selected.",
        "type": "boolean",
        "default": false
      },
      {
        "name": "indeterminate",
        "controllable": true,
        "visual": true,
        "description": "Mixed state for a parent summarising children.",
        "type": "boolean",
        "default": false
      },
      {
        "name": "disabled",
        "controllable": false,
        "visual": true,
        "description": "Inert and dimmed.",
        "type": "boolean",
        "default": false
      },
      {
        "name": "name",
        "controllable": false,
        "visual": false,
        "description": "Form field name.",
        "type": "string"
      },
      {
        "name": "value",
        "controllable": false,
        "visual": false,
        "description": "Submitted while checked.",
        "type": "string",
        "default": "on"
      }
    ],
    "events": [
      {
        "name": "change",
        "description": "Fires once per user toggle, never when set from code.",
        "detail": "{ checked: boolean }"
      }
    ],
    "states": {
      "structural": [
        "checked",
        "indeterminate"
      ],
      "styling": [
        "hover",
        "focus",
        "disabled"
      ]
    },
    "parts": [
      "checked-indicator",
      "indeterminate-indicator"
    ],
    "slots": [],
    "composes": [
      "Field"
    ],
    "form": {
      "participates": true,
      "submits": "value while checked, nothing otherwise"
    },
    "accessibility": {
      "role": "checkbox",
      "keyboard": "Space toggles"
    }
  },
  "behavior": [
    {
      "id": "toggle",
      "text": "click or Space flips checked; a click while indeterminate sets checked and clears indeterminate."
    },
    {
      "id": "change-event",
      "text": "change fires once per user toggle, never when checked is set from code."
    },
    {
      "id": "disabled",
      "text": "no interaction and no events while disabled; still focusable for assistive technology, as native."
    },
    {
      "id": "form",
      "text": "submits value while checked and nothing otherwise, matching native <input type=checkbox>."
    },
    {
      "id": "label",
      "text": "composes with Field; clicking the label toggles, per Field's rules."
    }
  ],
  "examples": [
    {
      "name": "checked",
      "sets": [
        {
          "at": "root",
          "state": "checked"
        }
      ]
    }
  ],
  "styles": [
    {
      "keys": {
        "state": "checked"
      },
      "values": {
        "root": {
          "fills": "{surface#accent}",
          "strokes": "{surface#accent}"
        },
        "checked-indicator": {
          "visible": true
        }
      }
    },
    {
      "keys": {
        "state": "indeterminate"
      },
      "values": {
        "root": {
          "fills": "{surface#accent}",
          "strokes": "{surface#accent}"
        },
        "indeterminate-indicator": {
          "visible": true
        }
      }
    },
    {
      "keys": {
        "state": "hover"
      },
      "values": {
        "root": {
          "strokes": "{border#hover}"
        }
      }
    },
    {
      "keys": {
        "state": "focus"
      },
      "values": {
        "root": {
          "strokes": "{border#focus}"
        }
      }
    },
    {
      "keys": {
        "state": "disabled"
      },
      "values": {
        "root": {
          "opacity": "{opacity#disabled}"
        }
      }
    }
  ]
}
