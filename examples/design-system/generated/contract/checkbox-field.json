{
  "id": "checkbox-field",
  "components": [
    {
      "name": "CheckboxField",
      "implements": null,
      "status": "stable",
      "boundParts": [],
      "treeSlots": [
        "control"
      ],
      "axes": {},
      "box": {
        "target": "instance",
        "node": "field",
        "component": "Field"
      },
      "laysOut": true
    }
  ],
  "contract": {
    "props": [
      {
        "name": "label",
        "type": "string",
        "controllable": false,
        "visual": false,
        "description": "The option's name.",
        "sample": "Remember me"
      },
      {
        "name": "description",
        "type": "string",
        "controllable": false,
        "visual": false,
        "description": "Helper text under the label.",
        "sample": "Stay signed in on this device."
      },
      {
        "name": "errorMessage",
        "type": "string",
        "controllable": false,
        "visual": false,
        "description": "Validation text, shown while in error.",
        "sample": "Choose one option."
      },
      {
        "name": "error",
        "type": "boolean",
        "controllable": false,
        "visual": false,
        "description": "Whether the field is in its error state.",
        "default": false
      }
    ],
    "events": [],
    "states": [],
    "parts": [],
    "slots": [],
    "composes": [
      "Field",
      "Checkbox"
    ]
  },
  "behavior": [
    {
      "id": "delegation",
      "text": "everything the label does, Field does; everything the box does, Checkbox does. This component adds layout only."
    }
  ],
