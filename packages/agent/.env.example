# Where the harness listens. The viewer panel reads VITE_UIDX_AGENT_URL.
UIDX_AGENT_URL=http://localhost:4500

# One model for everything. provider:model — vllm | ollama | lmstudio | anthropic
UIDX_AGENT_MODEL=vllm:gemma-3-27b-it
UIDX_AGENT_BASE_URL=http://localhost:8000/v1

# Optional: escalate malformed tool calls to a stronger model.
# UIDX_AGENT_REPAIR_MODEL=anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-...

# The model's context window, in tokens. Drives every read, outline and
# context-pack budget, so an override here is what lets a bigger model
# actually use its extra room.
# UIDX_AGENT_CONTEXT_TOKENS=16384

# Provider-specific request options, keyed by provider name, forwarded
# unchanged to every model call. This is the only route to a local runtime's
# own switches — and on a thinking model one of them is load-bearing.
#
# Measured against a real turn on qwen3.5 via Ollama: asked to study a page
# and report on one variant, the model wrote a complete, correct answer into
# its reasoning channel and left the text channel empty. The turn finished
# clean, the tool calls all landed, and the panel showed a spinner that
# stopped without a word. `chat_template_kwargs.enable_thinking` and Ollama's
# own `think: false` both changed nothing through the OpenAI-compatible shim.
# `reasoningEffort` was the one switch that did.
# UIDX_AGENT_PROVIDER_OPTIONS={"openai-compatible":{"reasoningEffort":"none"}}

# Whether the model can read an image. `view_image` refuses when this is off,
# rather than handing bytes to a text-only model that will confidently describe
# a picture it never saw.
# UIDX_AGENT_VISION=true

# fetch_url needs no configuration and calls nobody: the agent service fetches
# the page itself, refuses anything that resolves to this machine or its
# private network, and returns the words rather than the markup.
