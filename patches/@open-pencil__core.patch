+import { vectorEndpointShapes } from "../vector/endpoints.js";
+import { getStrokeJoinEntity } from "./strokes.js";
+
+// Draw body and tips into one opacity layer, so translucent arrowheads do not
+// darken where they overlap the centerline. Dash patterns apply to the body.
+function drawVectorEndpointStroke(r, canvas, node, paths, stroke, color) {
+  const tips = vectorEndpointShapes(node.vectorNetwork, stroke.weight, stroke.cap ?? node.strokeCap);
+  const layer = new r.ck.Paint();
+  layer.setAlphaf(stroke.opacity * color.a);
+  canvas.saveLayer(layer);
+  const paint = new r.ck.Paint();
+  paint.setAntiAlias(true);
+  paint.setColor(r.ck.Color4f(color.r, color.g, color.b, 1));
+  paint.setStyle(r.ck.PaintStyle.Stroke);
+  paint.setStrokeWidth(stroke.weight);
+  paint.setStrokeCap(r.ck.StrokeCap.Butt);
+  paint.setStrokeJoin(getStrokeJoinEntity(r, stroke.join ?? node.strokeJoin));
+  paint.setStrokeMiter(node.strokeMiterLimit);
+  const dash = stroke.dashPattern?.length ? r.ck.PathEffect.MakeDash(stroke.dashPattern, 0) : null;
+  paint.setPathEffect(dash);
+  for (const path of paths) canvas.drawPath(path, paint);
+  paint.setPathEffect(null);
+  dash?.delete();
+  for (const tip of tips) {
+    const path = r.ck.Path.MakeFromSVGString(tip.d);
+    if (!path) continue;
+    paint.setStyle(tip.stroke ? r.ck.PaintStyle.Stroke : r.ck.PaintStyle.Fill);
+    canvas.drawPath(path, paint);
+    path.delete();
+  }
+  canvas.restore();
+  paint.delete();
+  layer.delete();
+}
