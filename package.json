{
  "name": "uidx-monorepo",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "postinstall": "node scripts/setup-assets.mjs",
    "setup:assets": "node scripts/setup-assets.mjs",
    "viewer": "pnpm dev",
    "build": "pnpm -r --filter \"@uidx/format\" --filter \"@uidx/schema\" --filter \"@uidx/server\" build",
    "build:cli": "pnpm build && pnpm --filter @uidx/agent build && pnpm --filter @uidx/viewer build && pnpm --filter @uidxkit/uidx build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:release": "pnpm build:cli && node scripts/pack-release.mjs",
    "test:install": "node scripts/smoke-install.mjs",
    "dev": "pnpm build && pnpm --filter @uidx/agent build && pnpm --filter @uidxkit/uidx build && node packages/cli/dist/uidx.js dev --viewer-dev",
    "test:linked": "node scripts/smoke-install.mjs --linked",
    "uidx": "uidx dev",
    "uidx:mcp": "uidx mcp",
    "audit:release": "node scripts/audit-release.mjs",
    "test:security": "node scripts/check-dependency-fixes.mjs",
    "test:release": "node --test scripts/test-release.mjs",
    "test:canvas": "node scripts/canvas-canary.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@uidxkit/uidx": "workspace:*",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-vue": "^9",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3",
    "typescript-eslint": "^8.70.0",
    "vue-eslint-parser": "^9"
  },
  "pnpm": {
    "patchedDependencies": {
      "@open-pencil/core": "patches/@open-pencil__core.patch",
      "@open-pencil/scene-graph@0.14.0": "patches/@open-pencil__scene-graph@0.14.0.patch",
      "image-size@1.2.1": "patches/image-size@1.2.1.patch"
    },
    "overrides": {
      "@xmldom/xmldom": "0.9.12",
      "expr-eval": "npm:expr-eval-fork@3.0.3",
      "vite": "8.3.0",
      "esbuild": "0.28.1",
      "js-yaml": "4.3.2"
    },
    "neverBuiltDependencies": [
      "playwright"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uidxkit/uidx.git"
  },
  "homepage": "https://github.com/uidxkit/uidx#readme",
  "bugs": {
    "url": "https://github.com/uidxkit/uidx/issues"
  }
}
